# ==============================================================
# HƯỚNG DẪN CẤU HÌNH MONGODB ATLAS (THUONGTEA)
# ==============================================================

# 1. Đường dẫn kết nối MongoDB Atlas (Thay thế <password> và <cluster> bằng thông tin của bạn)
# Ví dụ: mongodb+srv://admin:matkhau123@cluster0.abcde.mongodb.net/thuongtea?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/thuongtea?retryWrites=true&w=majority

# 2. Tên cơ sở dữ liệu trên MongoDB Atlas (mặc định: thuongtea)
MONGODB_DB_NAME=thuongtea

# 3. Cổng chạy backend server (mặc định: 5000)
PORT=5000

# 4. (Tùy chọn) URL Backend nếu frontend deploy riêng biệt ở nền tảng khác
# VITE_API_URL=https://thuongtea.onrender.com
